# ─── Banco de dados ──────────────────────────────────────────────────────────
# String de conexão PostgreSQL. Serviços gratuitos para começar: Neon, Supabase ou Railway.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/classlink?schema=public"

# ─── Autenticação (JWT) ──────────────────────────────────────────────────────
# Segredo usado para assinar o access token. Gere um valor aleatório forte, ex:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"

# ─── Firebase (notificações push + upload de fotos/vídeos do mural) ─────────
# Console: https://console.firebase.google.com — um único projeto Firebase cobre as
# duas coisas. Veja o passo a passo completo em "Ativando o Firebase" no README.

# Config pública do app web (Configurações do projeto > Geral > Seus apps > Web).
# Estas variáveis são expostas ao navegador (prefixo NEXT_PUBLIC_ obrigatório no Next.js).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="" # também usado pelo backend p/ upload de mídia
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Chave VAPID (Configurações do projeto > Cloud Messaging > Certificados push da Web).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Credenciais da conta de serviço (Configurações do projeto > Contas de serviço > Gerar nova
# chave privada), usadas pelo backend para ENVIAR as notificações.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Cole a chave privada mantendo as quebras de linha como "\n" (formato do JSON baixado).
FIREBASE_PRIVATE_KEY=""

# ─── Jobs agendados (cron) ───────────────────────────────────────────────────
# Segredo enviado como "Authorization: Bearer $CRON_SECRET" pelo Vercel Cron (ou pelo
# seu scheduler) para autorizar as rotas /api/cron/*. Gere com: openssl rand -hex 32
CRON_SECRET=""

# ─── Banco Inter (emissão de boletos — Módulo Financeiro) ───────────────────
# Veja o passo a passo completo em "Emissão de boletos via Banco Inter" no README.
# Ambiente: "sandbox" (padrão, para testes) ou "producao".
BANCO_INTER_AMBIENTE="sandbox"
BANCO_INTER_CLIENT_ID=""
BANCO_INTER_CLIENT_SECRET=""
# Caminhos para os arquivos do certificado digital (mTLS) baixados no portal do Inter.
BANCO_INTER_CERT_PATH="./certs/inter-certificado.crt"
BANCO_INTER_KEY_PATH="./certs/inter-chave.key"
# Número da conta corrente Inter usada para emitir as cobranças.
BANCO_INTER_CONTA_CORRENTE=""
# Segredo próprio (não é do Inter) incluído na URL do webhook cadastrado — veja o README.
BANCO_INTER_WEBHOOK_SECRET=""

# ─── WhatsApp Cloud API — Meta (mensagens — Módulo Mensagens) ───────────────
# Veja o passo a passo completo em "Ativando WhatsApp e e-mail" no README.
# Meta Business Manager > WhatsApp > Configuração da API.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Valor que você mesmo escolhe e usa também ao cadastrar o webhook no Meta Developer Console.
WHATSAPP_VERIFY_TOKEN=""
# "Chave secreta do aplicativo" do app Meta — usada para validar a assinatura do webhook.
WHATSAPP_APP_SECRET=""

# ─── Mailgun (envio/recebimento de e-mail — Módulo Mensagens) ───────────────
MAILGUN_API_KEY=""
# Domínio verificado no Mailgun (ex: mail.suaescola.com.br).
MAILGUN_DOMAIN=""
# "eu" se sua conta Mailgun foi criada na região Europa; deixe em branco para região padrão (US).
MAILGUN_REGION=""
# E-mail remetente (ex: escola@mail.suaescola.com.br) — precisa ser do domínio verificado acima.
EMAIL_FROM=""
# Settings > Webhooks > "HTTP webhook signing key" no painel do Mailgun.
MAILGUN_WEBHOOK_SIGNING_KEY=""
