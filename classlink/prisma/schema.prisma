// ClassLink — schema do banco de dados
// Modelo de dados pensado para minimizar coleta de dados de menores (LGPD):
// os dados do aluno ficam restritos ao essencial (nome, turma, data de nascimento opcional)
// e o vínculo com responsáveis é explícito e revogável.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // diretor/gestor escolar
  STAFF // professor/funcionário
  GUARDIAN // responsável (pai/mãe/tutor)
}

// Função na equipe (só ADMIN/STAFF). Define o perfil: DIRECAO → ADMIN; COORDENACAO →
// STAFF com isCoordenacao; PROFESSOR e AUXILIAR → STAFF. Nulo em cadastros antigos (a
// função é deduzida do perfil).
enum FuncaoEquipe {
  DIRECAO
  COORDENACAO
  PROFESSOR
  AUXILIAR
}

enum PostAudience {
  SCHOOL // mural geral da escola
  CLASS // mural de uma turma específica
  STUDENT // apenas para Comunicado: direcionado a um aluno específico (aos seus responsáveis)
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  JUSTIFIED
}

enum ComunicadoTipo {
  AUTORIZACAO_PASSEIO
  CONFIRMACAO_REUNIAO
  CIRCULAR
}

enum RespostaTipo {
  AUTORIZADO
  NAO_AUTORIZADO
  CONFIRMADO
  NAO_COMPARECERA
  LIDO
  PENDENTE_EXPIRADO // gerado automaticamente pelo job de expiração, nunca pelo cliente
}

enum BoletoStatus {
  PENDENTE
  PAGO
  VENCIDO
  ERRO // falha na emissão junto ao Banco Inter
}

enum Trimestre {
  PRIMEIRO
  SEGUNDO
  TERCEIRO
}

enum SolicitacaoMatriculaTipo {
  PRE_MATRICULA // família nova interessada em uma vaga
  REMATRICULA // família atual confirmando a continuidade no ano seguinte
}

enum SolicitacaoMatriculaStatus {
  NOVA
  EM_ATENDIMENTO
  VISITA_AGENDADA
  MATRICULADO
  DESISTIU
}

enum SolicitacaoMatriculaOrigem {
  SITE // formulário da página pública hospedada fora do app (GitHub Pages/Hostinger)
  CLASSLINK // formulário da página /matriculas ou aviso do painel, dentro do app
}

enum MessageChannel {
  APP // enviada/lida só dentro do ClassLink
  WHATSAPP
  EMAIL
}

model School {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Configuração de cobrança (Módulo Boleto — Banco Inter)
  diaVencimentoPadrao Int? // dia do mês usado como vencimento quando o aluno não tem um específico
  diaEmissaoBoletos   Int? // dia do mês em que o job de emissão deve rodar

  users                 User[]
  classes               Class[]
  students              Student[]
  posts                 Post[]
  cardapios             Cardapio[]
  events                Event[]
  comunicados           Comunicado[]
  enquetes              Enquete[]
  boletos               Boleto[]
  disciplinas           Disciplina[]
  teamConversations     TeamConversation[]
  solicitacoesMatricula SolicitacaoMatricula[]
  contratos             Contrato[]
  contratoConfigs       ContratoConfig[]
  matriculaDocumentos   MatriculaDocumento[]
  consentimentosLgpd    ConsentimentoLgpd[]
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  passwordHash String
  name         String
  role         Role
  // Único (Fase 2 do telefone): o login por telefone procura um só usuário. O cadastro grava
  // sempre no padrão 55 + DDD + número; exclusão (LGPD) zera o campo, então não trava recadastro.
  phone        String?   @unique
  avatarUrl    String?
  active       Boolean   @default(true)
  deletedAt    DateTime? // exclusão lógica (LGPD) antes de expurgo definitivo

  // Permissão extra para STAFF: coordenação pedagógica pode lançar notas (além da direção/ADMIN).
  isCoordenacao Boolean @default(false)

  // Equipe (ADMIN/STAFF): receber no WhatsApp (pelo número da escola) um aviso quando
  // chega mensagem nova no ClassLink. Opt-in pela própria pessoa, em Conta.
  avisosWhatsApp Boolean @default(false)

  funcao FuncaoEquipe?

  // Equipe: como a pessoa aparece para as famílias (ex.: "Secretaria"). Vazio = o cargo
  // ("Direção", "Coordenação"...). Famílias nunca veem o nome pessoal da equipe.
  nomeParaFamilias String?

  // Última mensagem recebida desta pessoa no WhatsApp da escola. Nas 24h seguintes a Meta
  // entrega texto livre (senha direto); fora disso, só modelo aprovado (convite).
  whatsappUltimaMensagemEm DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Dados de cobrança (Módulo Boleto — Banco Inter). Preenchidos apenas pelo próprio
  // responsável, só quando necessário para emissão de boleto (CPF e endereço são
  // exigidos pelo registro bancário do boleto) — nunca coletados no cadastro padrão.
  cpf              String?
  enderecoCobranca Json?

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  // Professor/Funcionário: turmas em que leciona
  classesTeaching ClassTeacher[]

  // Responsável: alunos vinculados
  studentLinks GuardianStudent[]

  postsAuthored    Post[]         @relation("PostAuthor")
  cardapiosCriados Cardapio[]     @relation("CardapioAutor")
  postReads        PostRead[]
  eventsCreated    Event[]        @relation("EventAuthor")
  refreshTokens    RefreshToken[]
  pushTokens       PushToken[]
  messagesSent     Message[]      @relation("MessageSender")
  conversationsA   Conversation[] @relation("ConversationStaff")
  conversationsB   Conversation[] @relation("ConversationGuardian")
  attendanceMarked Attendance[]   @relation("AttendanceMarkedBy")

  // Mensagens internas entre equipe (ADMIN/STAFF) — separado de Conversation/Message,
  // que são sempre entre um funcionário e um responsável (inclusive com envio por
  // WhatsApp/e-mail, que não faz sentido aqui).
  teamConversationsA TeamConversation[] @relation("TeamConversationUserA")
  teamConversationsB TeamConversation[] @relation("TeamConversationUserB")
  teamMessagesSent   TeamMessage[]      @relation("TeamMessageSender")

  comunicadosCriados  Comunicado[]         @relation("ComunicadoAuthor")
  respostasComunicado RespostaComunicado[] @relation("RespostaResponsavel")
  comunicadoLeituras  ComunicadoLeitura[]
  enquetesCriadas     Enquete[]            @relation("EnqueteAuthor")
  enqueteParticipacoes EnqueteParticipacao[]
  enqueteEnvios       EnqueteEnvio[]
  notasLancadas       Nota[]               @relation("NotaLancadaPor")

  // Responsável: rematrículas confirmadas pelo aviso do painel
  solicitacoesMatricula SolicitacaoMatricula[] @relation("SolicitacaoMatriculaResponsavel")

  // Contratos de matrícula: criados pela direção, arquivos enviados e trilha de auditoria
  contratosCriados         Contrato[]        @relation("ContratoCriadoPor")
  contratoConfigsEditadas  ContratoConfig[]  @relation("ContratoConfigEditadaPor")
  contratoArquivosEnviados ContratoArquivo[] @relation("ContratoArquivoEnviadoPor")
  contratoEventos          ContratoEvento[]  @relation("ContratoEventoUsuario")

  // Avisos enviados pelo WhatsApp da escola e respostas recebidas por lá (responder pelo WhatsApp)
  whatsappVinculos WhatsAppVinculoConversa[]

  // Consentimentos LGPD registrados em nome deste responsável (SetNull ao excluir a conta)
  consentimentosLgpd ConsentimentoLgpd[]

  @@index([schoolId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Contador de falhas de login por identificador (HMAC, nunca o e-mail/telefone em texto).
model LoginTentativa {
  chave           String    @id
  falhas          Int
  primeiraFalhaEm DateTime
  bloqueadoAte    DateTime?
  atualizadoEm    DateTime  @updatedAt
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Class {
  id        String   @id @default(cuid())
  name      String
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  teachers    ClassTeacher[]
  students    Student[]
  posts       Post[]
  cardapios   Cardapio[]
  events      Event[]
  comunicados Comunicado[]
  enquetes    Enquete[]

  @@index([schoolId])
}

model ClassTeacher {
  id        String @id @default(cuid())
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String

  @@unique([classId, teacherId])
  @@index([teacherId])
}

model Student {
  id        String    @id @default(cuid())
  name      String
  birthDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String

  // Módulo financeiro simplificado (Módulo Boleto — Banco Inter)
  mensalidadeValor Decimal? @db.Decimal(10, 2)
  diaVencimento    Int? // sobrepõe School.diaVencimentoPadrao quando definido

  guardians              GuardianStudent[]
  attendances            Attendance[]
  respostasComunicado    RespostaComunicado[]
  boletos                Boleto[]
  notas                  Nota[]
  comunicadosIndividuais Comunicado[]
  enquetesIndividuais    Enquete[]
  contratos              Contrato[]
  documentosMatricula    MatriculaDocumento[]
  consentimentosLgpd     ConsentimentoLgpd[]

  @@index([schoolId])
  @@index([classId])
}

// Vínculo explícito e revogável entre responsável e aluno
model GuardianStudent {
  id         String   @id @default(cuid())
  guardian   User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  guardianId String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  relation   String? // ex: "mãe", "pai", "tutor legal"
  createdAt  DateTime @default(now())

  @@unique([guardianId, studentId])
  @@index([studentId])
}

model Post {
  id        String       @id @default(cuid())
  title     String
  body      String
  mediaUrl  String?
  mediaType String? // "image" | "video"
  audience  PostAudience

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String?

  author   User   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads    PostRead[]
  cardapio Cardapio?

  @@index([schoolId])
  @@index([classId])
}

// Confirmação de leitura ("visto por")
model PostRead {
  id     String   @id @default(cuid())
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  readAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model Conversation {
  id         String   @id @default(cuid())
  staff      User     @relation("ConversationStaff", fields: [staffId], references: [id], onDelete: Cascade)
  staffId    String
  guardian   User     @relation("ConversationGuardian", fields: [guardianId], references: [id], onDelete: Cascade)
  guardianId String
  createdAt  DateTime @default(now())

  messages Message[]

  @@unique([staffId, guardianId])
}

model Message {
  id             String         @id @default(cuid())
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User           @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  channel        MessageChannel @default(APP)
  // id da mensagem no WhatsApp (wamid) ou Message-Id do e-mail — usado para
  // deduplicar webhooks (evita gravar a mesma mensagem duas vezes em reentregas)
  // e para resolver a conversa de uma resposta via WhatsApp (context.id).
  externalId     String?        @unique
  // Foto, documento, áudio etc. recebidos pelo WhatsApp. O arquivo fica no armazenamento
  // privado (anexoCaminho) e só é lido por link assinado; sem caminho = não deu para baixar.
  // anexoMediaId é o id da mídia na Meta (baixável por 7 dias), para nova tentativa.
  anexoTipo      String? // "image" | "sticker" | "document" | "audio" | "video"
  anexoMime      String?
  anexoNome      String?
  anexoCaminho   String?
  anexoMediaId   String?
  createdAt      DateTime       @default(now())
  readAt         DateTime?

  @@index([conversationId])
  @@index([externalId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String?

  author   User   @relation("EventAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
}

model Comunicado {
  id            String         @id @default(cuid())
  tipo          ComunicadoTipo
  titulo        String
  descricao     String
  audience      PostAudience // "toda_escola" ou turma específica (reaproveita o mesmo enum do mural)
  prazoResposta DateTime?

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String?

  // Somente quando audience = STUDENT: aluno específico (sempre direcionado aos responsáveis dele, nunca ao próprio aluno).
  aluno   Student? @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId String?

  criadoPor   User   @relation("ComunicadoAuthor", fields: [criadoPorId], references: [id], onDelete: Cascade)
  criadoPorId String

  dataCriacao DateTime @default(now())
  updatedAt   DateTime @updatedAt

  respostas RespostaComunicado[]
  leituras  ComunicadoLeitura[]

  @@index([schoolId])
  @@index([classId])
  @@index([alunoId])
}

// Abertura do comunicado pelo responsável: gravada pelo servidor na primeira vez que ele abre
// (horário nunca vem do cliente). Comprova leitura em circulares e é o "visto" nos demais tipos.
model ComunicadoLeitura {
  id           String     @id @default(cuid())
  comunicado   Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  comunicadoId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  lidoEm       DateTime   @default(now())

  @@unique([comunicadoId, userId])
  @@index([comunicadoId])
}

model RespostaComunicado {
  id               String       @id @default(cuid())
  comunicado       Comunicado   @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  comunicadoId     String
  responsavel      User         @relation("RespostaResponsavel", fields: [responsavelId], references: [id], onDelete: Cascade)
  responsavelId    String
  aluno            Student      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId          String
  resposta         RespostaTipo
  // Timestamp e IP sempre atribuídos pelo servidor no momento da requisição — nunca aceitos do cliente.
  dataHoraResposta DateTime
  ipOrigem         String?

  historico RespostaComunicadoLog[]

  // Um responsável só pode ter uma resposta vigente por comunicado/aluno; reenvios atualizam
  // este registro e a resposta anterior é preservada em RespostaComunicadoLog.
  @@unique([comunicadoId, responsavelId, alunoId])
  @@index([comunicadoId])
  @@index([responsavelId])
}

// Histórico imutável das respostas substituídas (auditoria de autorizações — LGPD/segurança jurídica).
model RespostaComunicadoLog {
  id                       String             @id @default(cuid())
  respostaComunicado       RespostaComunicado @relation(fields: [respostaComunicadoId], references: [id], onDelete: Cascade)
  respostaComunicadoId     String
  respostaAnterior         RespostaTipo
  dataHoraRespostaAnterior DateTime
  ipOrigemAnterior         String?
  substituidaEm            DateTime           @default(now())

  @@index([respostaComunicadoId])
}

// Boleto mensal emitido via API do Banco Inter. Não persistimos o PDF em si —
// ele é buscado sob demanda na API do Inter usando codigoSolicitacao (evita
// guardar documento bancário em repouso além do necessário).
model Boleto {
  id            String       @id @default(cuid())
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId      String
  mesReferencia String // formato "AAAA-MM"
  valor         Decimal      @db.Decimal(10, 2)
  vencimento    DateTime
  status        BoletoStatus @default(PENDENTE)

  codigoSolicitacao String? @unique // identificador retornado pelo Inter na emissão
  nossoNumero       String?
  linhaDigitavel    String?
  pixCopiaCola      String?
  erroDetalhe       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  pagoEm    DateTime?

  baixas BoletoBaixaLog[]

  @@unique([studentId, mesReferencia])
  @@index([schoolId])
  @@index([status])
}

/// Trilha de auditoria da baixa manual: quem marcou/desfez o pagamento, quando e com qual data.
/// O nome fica copiado aqui para o registro sobreviver à exclusão do usuário.
model BoletoBaixaLog {
  id             String       @id @default(cuid())
  boleto         Boleto       @relation(fields: [boletoId], references: [id], onDelete: Cascade)
  boletoId       String
  schoolId       String
  acao           String // "PAGO" | "DESFAZER"
  statusAnterior BoletoStatus
  statusNovo     BoletoStatus
  dataPagamento  DateTime? // data informada na baixa (nula ao desfazer)
  valor          Decimal      @db.Decimal(10, 2) // valor do boleto no momento da ação
  porUserId      String
  porNome        String
  criadoEm       DateTime     @default(now())

  @@index([boletoId])
  @@index([schoolId, criadoEm])
}

/// Histórico de alterações de cadastro (por enquanto, o aluno): quem alterou, quando, qual
/// campo e os valores anterior e novo. Somente inserção. Sem chave estrangeira de propósito:
/// o registro sobrevive à exclusão de quem alterou, e a mesma tabela serve depois para
/// outros cadastros (responsáveis, turmas). Nome de quem alterou fica copiado aqui.
model AlteracaoCadastro {
  id            String   @id @default(cuid())
  schoolId      String
  entidade      String // "ALUNO"
  entidadeId    String
  campo         String // "nome" | "turma" | "nascimento"
  valorAnterior String?
  valorNovo     String?
  porUserId     String
  porNome       String
  criadoEm      DateTime @default(now())

  @@index([schoolId, entidade, entidadeId, criadoEm])
}

// Disciplina lecionada na escola (ex.: "Matemática", "Português"). Escopo por escola,
// não por turma — todas as turmas compartilham o mesmo catálogo de disciplinas.
model Disciplina {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  notas Nota[]

  @@unique([schoolId, nome])
  @@index([schoolId])
}

// Notas de um aluno em uma disciplina, por trimestre. Lançadas apenas por ADMIN
// (direção) ou STAFF marcado como coordenação (User.isCoordenacao) — nunca pelo
// próprio professor da turma nem pelo responsável.
// Média do trimestre = (trabalho*3 + teste*7 + prova*10) / 20 (pesos definidos pela escola).
// Média final = média das 3 médias trimestrais. Aprovado quando média final >= 6.
model Nota {
  id           String     @id @default(cuid())
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  disciplinaId String
  trimestre    Trimestre

  trabalho Decimal? @db.Decimal(4, 2)
  teste    Decimal? @db.Decimal(4, 2)
  prova    Decimal? @db.Decimal(4, 2)

  lancadoPor   User   @relation("NotaLancadaPor", fields: [lancadoPorId], references: [id], onDelete: Cascade)
  lancadoPorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, disciplinaId, trimestre])
  @@index([studentId])
  @@index([disciplinaId])
}

model Attendance {
  id         String           @id @default(cuid())
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  date       DateTime
  status     AttendanceStatus
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Cascade)
  markedById String
  createdAt  DateTime         @default(now())

  @@unique([studentId, date])
  @@index([studentId])
}

// Conversa interna entre dois membros da equipe (ADMIN/STAFF) da mesma escola — ex:
// direção falando com um professor, ou um professor com outro. Deliberadamente separada
// de Conversation (que é sempre entre um funcionário e um responsável, com opção de
// envio por WhatsApp/e-mail): aqui os dois participantes são internos, então não há
// canal externo nem restrição de "atende a mesma turma".
// userAId é sempre o menor id em ordem lexicográfica entre os dois participantes (a
// aplicação normaliza isso antes de gravar), para nunca existir a mesma dupla duas vezes
// em ordem trocada.
model TeamConversation {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  userA   User   @relation("TeamConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userAId String
  userB   User   @relation("TeamConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  userBId String

  createdAt DateTime @default(now())

  messages TeamMessage[]

  @@unique([userAId, userBId])
  @@index([schoolId])
  @@index([userAId])
  @@index([userBId])
}

model TeamMessage {
  id             String           @id @default(cuid())
  conversation   TeamConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User             @relation("TeamMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime         @default(now())
  readAt         DateTime?

  @@index([conversationId])
}

// Pré-matrículas e rematrículas enviadas pelos formulários públicos de matrícula ou pelo
// aviso de rematrícula do painel. Ficam visíveis só para a administração (ADMIN), que
// acompanha o atendimento pelo status. Dados mínimos, coletados com consentimento
// explícito (LGPD) — o horário do consentimento é gravado pelo servidor.
model SolicitacaoMatricula {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  tipo      SolicitacaoMatriculaTipo
  status    SolicitacaoMatriculaStatus @default(NOVA)
  origem    SolicitacaoMatriculaOrigem
  anoLetivo Int

  responsavelNome String
  telefone        String // só dígitos, com DDI 55
  alunoNome       String // um ou mais nomes (rematrícula de irmãos)
  serie           String?
  periodoVisita   String?
  escolaAtual     String?
  observacoes     String?

  // Preenchido quando a solicitação vem de um responsável logado (aviso do painel).
  responsavel   User?   @relation("SolicitacaoMatriculaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  responsavelId String?

  observacoesInternas String? // anotações da equipe, nunca exibidas à família
  consentimentoEm     DateTime
  ipOrigem            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([schoolId, anoLetivo, tipo, status])
  @@index([ipOrigem, createdAt])
}

// ─── Contratos de matrícula ────────────────────────────────────────────────────
// A direção envia o PDF do contrato já preenchido; a família baixa, assina (de
// preferência pelo gov.br — assinatura eletrônica avançada, Lei 14.063/2020 — ou à
// mão) e devolve o PDF assinado pelo app. A secretaria confere. Assinatura à mão só
// fica COMPLETA depois que a via original em papel é entregue na escola.
// Sem custo de plataforma de assinatura: a prova vem do próprio arquivo (gov.br,
// verificável em validar.iti.gov.br) e da trilha de auditoria abaixo (quem enviou,
// quando, de qual IP e o hash SHA-256 do arquivo, todos atribuídos pelo servidor).

enum ContratoStatus {
  AGUARDANDO_ASSINATURA // enviado à família, aguardando o PDF assinado
  EM_CONFERENCIA // família enviou o PDF assinado; secretaria precisa conferir
  AGUARDANDO_ORIGINAL // assinatura à mão conferida; falta entregar a via original em papel
  COMPLETO
  DEVOLVIDO // secretaria devolveu o envio com um motivo; a família pode reenviar
}

enum ContratoMetodoAssinatura {
  GOVBR // PDF assinado no Assinador gov.br (assinatura eletrônica avançada)
  MANUSCRITA // assinado à mão e digitalizado; exige a via original em papel
}

enum ContratoArquivoTipo {
  MODELO // contrato preenchido enviado pela escola
  ASSINADO // PDF assinado enviado pela família (reenvios ficam guardados para auditoria)
}

enum ContratoEventoTipo {
  CRIADO
  DADOS_PREENCHIDOS // família conferiu os dados e o app gerou o PDF do contrato
  ASSINADO_ENVIADO
  DEVOLVIDO
  CONFERIDO
  ORIGINAL_RECEBIDO
}

model Contrato {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  anoLetivo Int
  titulo    String
  status    ContratoStatus @default(AGUARDANDO_ASSINATURA)

  // Preenchidos quando a família envia o PDF assinado (horário sempre do servidor).
  metodoAssinatura  ContratoMetodoAssinatura?
  assinadoEnviadoEm DateTime?
  motivoDevolucao   String? // último motivo informado pela secretaria ao devolver

  // Contratos do modelo do app (ex.: "ESPACO_KIDS_2027"): o PDF é gerado a partir das
  // condições fixadas no envio (cópia da configuração do ano) e dos dados que a família
  // confere. Nulo para contratos enviados como PDF avulso.
  modelo       String?
  condicoes    Json?
  dadosFamilia Json?

  criadoPor   User?   @relation("ContratoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arquivos ContratoArquivo[]
  eventos  ContratoEvento[]

  @@index([schoolId, anoLetivo, status])
  @@index([studentId])
}

// Conteúdo dos PDFs guardado no próprio banco: privado por padrão (só sai por rota
// autenticada que confere o vínculo), sem serviço extra. Consultas de listagem nunca
// selecionam `conteudo`. Excluído junto com o contrato (LGPD).
model ContratoArquivo {
  id         String              @id @default(cuid())
  contrato   Contrato            @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  contratoId String
  tipo       ContratoArquivoTipo

  nomeArquivo  String
  mimeType     String
  tamanhoBytes Int
  sha256       String // impressão digital do arquivo, calculada pelo servidor
  conteudo     Bytes

  enviadoPor   User?    @relation("ContratoArquivoEnviadoPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)
  enviadoPorId String?
  ipOrigem     String?
  createdAt    DateTime @default(now())

  @@index([contratoId, tipo])
}

// Trilha de auditoria imutável (somente inserção) de tudo o que acontece com o contrato.
model ContratoEvento {
  id         String             @id @default(cuid())
  contrato   Contrato           @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  contratoId String
  tipo       ContratoEventoTipo

  usuario       User?    @relation("ContratoEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId     String?
  ipOrigem      String?
  arquivoSha256 String?
  detalhe       String?
  createdAt     DateTime @default(now())

  @@index([contratoId])
}

// Configuração do contrato da escola por ano letivo: valores por período, parcelas, hora
// excedente e dados da escola que entram no contrato gerado. Preenchida pela direção no
// painel; o envio fica bloqueado enquanto faltar algum valor obrigatório.
model ContratoConfig {
  id        String @id @default(cuid())
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  anoLetivo Int
  dados     Json

  editadoPor   User?    @relation("ContratoConfigEditadaPor", fields: [editadoPorId], references: [id], onDelete: SetNull)
  editadoPorId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schoolId, anoLetivo])
}

/// Liga uma mensagem do WhatsApp da escola (wamid) a uma conversa do ClassLink, para que a
/// direção/coordenação responda direto pelo WhatsApp: "AVISO" = aviso ou confirmação que a
/// escola enviou à pessoa (a resposta a ele volta para essa conversa); "RESPOSTA" = resposta
/// já recebida e processada (evita duplicar quando a Meta reenvia o webhook).
model WhatsAppVinculoConversa {
  id             String               @id @default(cuid())
  externalId     String               @unique
  papel          PapelVinculoWhatsApp
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  tipo           TipoConversaWhatsApp
  conversationId String
  createdAt      DateTime             @default(now())

  @@index([userId, papel, createdAt])
}

enum PapelVinculoWhatsApp {
  AVISO
  RESPOSTA
}

enum TipoConversaWhatsApp {
  FAMILIA
  EQUIPE
}

/// Cardápio semanal (segunda a sexta), cadastrado com antecedência pela direção/coordenação
/// e publicado automaticamente na segunda-feira da semana: vira uma publicação no Mural e
/// as famílias recebem notificação. Sem turma = toda a escola.
model Cardapio {
  id       String  @id @default(cuid())
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String
  class    Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId  String?

  /// Segunda-feira da semana (data, sem horário).
  semanaInicio DateTime @db.Date
  /// { refeicoes: string[], itens: { seg: string[], ter: [...], qua, qui, sex } } — itens[dia][i] é a refeição i.
  conteudo     Json
  observacoes  String?
  /// Caminho da foto no armazenamento (mesmo esquema do Mural), opcional.
  imagemPath   String?

  status      StatusCardapio @default(AGENDADO)
  publicadoEm DateTime?
  post        Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  postId      String?        @unique

  criadoPor   User   @relation("CardapioAutor", fields: [criadoPorId], references: [id], onDelete: Cascade)
  criadoPorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, semanaInicio])
  @@index([status, semanaInicio])
}

enum StatusCardapio {
  AGENDADO
  PUBLICADO
}

// ─── Enquetes (pesquisas de satisfação e outras consultas às famílias) ───

// Pesquisa dirigida à escola toda, a uma turma ou a um aluno (aos responsáveis dele), no mesmo
// modelo de público dos comunicados.
model Enquete {
  id          String       @id @default(cuid())
  titulo      String
  descricao   String?
  audience    PostAudience
  // Anônima por padrão: o sistema registra QUE a família respondeu, mas não liga a pessoa às respostas.
  anonima     Boolean      @default(true)
  prazo       DateTime?
  encerradaEm DateTime?

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String?

  aluno   Student? @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId String?

  criadoPor   User   @relation("EnqueteAuthor", fields: [criadoPorId], references: [id], onDelete: Cascade)
  criadoPorId String

  dataCriacao DateTime @default(now())

  perguntas     EnquetePergunta[]
  participacoes EnqueteParticipacao[]
  envios        EnqueteEnvio[]

  @@index([schoolId])
  @@index([classId])
  @@index([alunoId])
}

// "tipo" é texto (e não enum do banco) de propósito: novos tipos de pergunta entram só no código
// (src/lib/enquetes.ts), sem migração. "opcoes" guarda a configuração do tipo (ex.: lista de escolhas).
model EnquetePergunta {
  id         String  @id @default(cuid())
  enquete    Enquete @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  enqueteId  String
  ordem      Int
  tipo       String
  texto      String
  obrigatoria Boolean @default(true)
  opcoes     Json?

  itens EnqueteItem[]

  @@index([enqueteId])
}

// Controle de quem já respondeu (uma por responsável). NÃO aponta para o envio: é isso que
// preserva o anonimato.
model EnqueteParticipacao {
  id          String   @id @default(cuid())
  enquete     Enquete  @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  enqueteId   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  respondidoEm DateTime @default(now())

  @@unique([enqueteId, userId])
  @@index([enqueteId])
}

// Um conjunto de respostas. Em enquete anônima, userId e respondidoEm ficam nulos e o id é
// aleatório (uuid), sem horário embutido, para não permitir cruzar com a participação.
model EnqueteEnvio {
  id           String    @id @default(uuid())
  enquete      Enquete   @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  enqueteId    String
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  respondidoEm DateTime?

  itens EnqueteItem[]

  @@index([enqueteId])
}

model EnqueteItem {
  id         String          @id @default(cuid())
  envio      EnqueteEnvio    @relation(fields: [envioId], references: [id], onDelete: Cascade)
  envioId    String
  pergunta   EnquetePergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  perguntaId String
  numero     Int?
  texto      String?

  @@index([envioId])
  @@index([perguntaId])
}

// ─── Ficha da matrícula: checklist de documentos e consentimentos LGPD ───────────

enum MatriculaDocumentoTipo {
  CERTIDAO_NASCIMENTO
  CPF
  VACINACAO
  COMPROVANTE_RESIDENCIA
  HISTORICO_ESCOLAR
  LAUDO // voluntário e sensível: visível e editável só pela direção (ADMIN)
}

enum ConsentimentoFinalidade {
  DADOS_DA_CRIANCA
  USO_DE_IMAGEM
  DADO_DE_SAUDE
}

// Checklist de documentos por aluno e ano letivo. Só registra se foi entregue (não guarda
// o arquivo). Pendência de documento nunca bloqueia aula, prova ou outro documento.
model MatriculaDocumento {
  id         String                 @id @default(cuid())
  schoolId   String
  studentId  String
  anoLetivo  Int
  tipo       MatriculaDocumentoTipo
  recebido   Boolean                @default(false)
  recebidoEm DateTime?
  prazo      DateTime?
  observacao String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, anoLetivo, tipo])
  @@index([schoolId, anoLetivo, recebido])
}

// Consentimento LGPD por finalidade. Revogar preenche revogadoEm — o registro nunca é
// apagado (prova de quando e por quem o consentimento foi dado e retirado).
model ConsentimentoLgpd {
  id                String                  @id @default(cuid())
  schoolId          String
  studentId         String
  finalidade        ConsentimentoFinalidade
  versaoTexto       String
  consentidoPorId   String?
  consentidoPorNome String
  consentidoEm      DateTime                @default(now())
  revogadoEm        DateTime?
  createdAt         DateTime                @default(now())

  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  consentidoPor User?   @relation(fields: [consentidoPorId], references: [id], onDelete: SetNull)

  @@index([studentId, finalidade])
  @@index([schoolId])
}

// Violações de CSP (modo Report-Only) agrupadas por diretiva + origem bloqueada + página.
// Guarda só dados técnicos reduzidos (sem URLs completas, consulta, IP ou usuário).
// Erros inesperados do servidor (respostas 500), agrupados. A Vercel Hobby guarda só 1 hora
// de logs; aqui fica o histórico mostrado no Painel. Só a 1ª linha da mensagem, sem dados
// pessoais (e-mails, telefones e números longos são mascarados antes de gravar).
model ErroServidor {
  id          String   @id @default(cuid())
  chave       String   @unique
  origem      String
  mensagem    String
  total       Int      @default(1)
  primeiraVez DateTime @default(now())
  ultimaVez   DateTime @default(now())

  @@index([ultimaVez])
}

model CspViolacao {
  id          String   @id @default(cuid())
  chave       String   @unique
  diretiva    String
  bloqueado   String
  pagina      String
  total       Int      @default(1)
  primeiraVez DateTime @default(now())
  ultimaVez   DateTime @default(now())

  @@index([ultimaVez])
}
